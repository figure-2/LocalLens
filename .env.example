LOCALLENS_DATA_DIR=.locallens
LOCALLENS_WORKSPACE_ID=default
LOCALLENS_EMBEDDING_BACKEND=hash
LOCALLENS_TEXT_EMBEDDING_BACKEND=hash
LOCALLENS_VISION_EMBEDDING_BACKEND=hash
LOCALLENS_RERANK_MODE=off
LOCALLENS_QDRANT_URL=
LOCALLENS_QDRANT_TIMEOUT_SECONDS=60
LOCALLENS_TEXT_MODEL_NAME=intfloat/multilingual-e5-small
