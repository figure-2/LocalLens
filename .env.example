LOCALLENS_RELEASE_EVIDENCE_MODE=0
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
LOCALLENS_PDF_VISUAL_MODE=off
LOCALLENS_PDF_OCR_MODE=off
